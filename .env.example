# Copy to .env (git-ignored). Never commit .env or put real secrets here.
#
# ---- Full Docker run (docker-compose.yml) ----------------------------------
# Only these are read (by Compose, at run time). DATABASE_URL for the
# containers is set in docker-compose.yml (mongodb:27017 on the Compose network).
#
# Secret for signing (simulated) pre-signed upload URLs. Server-side only; at
# least 32 characters. Generate one with Docker only:
#   docker run --rm node:24.14.0-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or with Node installed:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UPLOAD_SIGNING_SECRET=""
# Host port for the app (published on 127.0.0.1 only). Optional.
APP_PORT=3080

# ---- Local development on Windows (npm run dev, worker, tests) -------------
# Both the Prisma CLI and Next.js read .env. Do not move DATABASE_URL to
# .env.local: the Prisma CLI does not read it.
# MongoDB from compose.dev.yaml (npm run db:up), no credentials.
# replicaSet=rs0 is required: Prisma's MongoDB connector uses transactions.
DATABASE_URL="mongodb://127.0.0.1:27017/signflow?replicaSet=rs0"

# Separate database for automated tests (integration tests, DB checks).
# Test runners refuse to write unless the database name ends in "_test" and
# differs from DATABASE_URL.
TEST_DATABASE_URL="mongodb://127.0.0.1:27017/signflow_test?replicaSet=rs0"
