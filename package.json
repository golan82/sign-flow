{
  "name": "sign-flow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait mongodb",
    "db:stop": "docker compose -f compose.dev.yaml stop mongodb",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "vitest run --project unit",
    "test:integration": "npm run db:push:test && vitest run --project integration",
    "db:push:test": "node --env-file=.env scripts/db-push-test.mts",
    "worker:claims": "node --env-file=.env scripts/claim-expiry-worker.mts",
    "test:db": "node --env-file=.env scripts/db-smoke-test.mts",
    "test:db:persistence": "node --env-file=.env scripts/db-persistence-check.mts",
    "test:ui": "node --env-file=.env tests/ui/ui-check.mts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "mongodb": "7.8.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
